# ==========================================
# 1. DATABASE POSTGRES
# ==========================================
POSTGRES_DB=chatapp_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# ==========================================
# 2. KAFKA BROKER (KRAFT MODE)
# ==========================================
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0

# ==========================================
# 3. BACKEND (.NET 10 CONFIG)
# ==========================================
ASPNETCORE_ENVIRONMENT=Development
DOTNET_USE_POLLING_FILE_WATCHER=true
# Kết nối Postgres (Lưu ý: Port nội bộ docker là 5432, user/pass khớp bên trên)
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=chatapp_db;Username=postgres;Password=postgrespassword
# Kết nối Redis & Kafka nội bộ
Redis__ConnectionString=redis:6379
Kafka__BootstrapServers=kafka:9092
RabbitMQ__Host=rabbitmq